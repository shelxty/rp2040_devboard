		(uuid "8bab85a7-2266-4c76-b109-3c1180c0368e")
	)
	(text "shield = conductive material\nwrapped around data pins\non the receptacle"
		(exclude_from_sim no)
		(at 20.32 104.648 0)
		(effects
			(font
				(size 0.635 0.635)
			)
		)
		(uuid "8c69ae39-e5fa-479f-acfd-640f76dd9910")
	)
	(text "need a quad SPI flash memory\nintegrated circuit \n\nthe W25Q128JVS is used on\nthe RP2040 datasheet"
		(exclude_from_sim no)
		(at 49.022 135.89 0)
		(effects
			(font
				(size 0.635 0.635)
			)
		)
		(uuid "a2b6675a-ec71-4182-bdb1-d84c857ca8f3")
	)
	(text "RP2040 doesn't have any flash\nstorage so we need to add our\nown flash storage"
		(exclude_from_sim no)
		(at 33.528 136.144 0)
		(effects
			(font
				(size 0.635 0.635)
			)
		)
		(uuid "ab0496c5-7e4e-45e6-9ed0-4b0bbd90dcfb")
	)
	(text "data pins that transfer data\nto/from the usb-c receptacle"
