				(size 0.635 0.635)
			)
		)
		(uuid "b842b022-2096-416c-982a-b96faf4aaac2")
	)
	(text "5V input that needs to be\nstepped down to 3.3V to \npower our microcontroller"
		(exclude_from_sim no)
		(at 35.56 72.39 0)
		(effects
			(font
				(size 0.635 0.635)
			)
