	)
	(text "holy frick it took a while to\ndecide whether between \nmb vs tt vs to but like\napparently mb has easier soldering\nsoooo yeah mb it is!"
		(exclude_from_sim no)
		(at 94.234 62.23 0)
		(effects
			(font
				(size 0.635 0.635)
			)
		)
		(uuid "d076bd03-7ef1-4c8a-867a-b3144c4ad16f")
	)
	(text "for the 1.1V line, there's two\nVDD pins so we need two 0.1uF\ncapacitors & one 1uF capacitor"
		(exclude_from_sim no)
		(at 109.22 22.606 0)
		(effects
			(font
				(size 0.635 0.635)
			)
		)
		(uuid "dae6df07-59bc-42f8-a6c8-c4bfa697cc47")
	)
	(text "see how the global labels\nare basically wires\nthat don't need actual\nwiring to be done?\nmakes it easier to connect\ncomponents to each other yk"
		(exclude_from_sim no)
		(at 92.202 124.968 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "dd742755-ad44-4c54-8af9-31692ce2ed33")
	)
	(text "it's standard to have 27 ohm \nresistors going into the MCU\nto prevent distortion of\nsignals at high speeds\n(they're called termination resistors)"
		(exclude_from_sim no)
		(at 120.396 98.552 0)
		(effects
			(font
				(size 0.635 0.635)
			)
		)
